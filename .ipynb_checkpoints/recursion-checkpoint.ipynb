   "source": [
    "def print_list(list, idx=0):\n",
    "    if (idx == len(list)):\n",
    "        return\n",
    "    print(list[idx])\n",
    "    print_list(list, idx+1)\n",
    "\n",
    "fruits = [\"mango\", \"litchi\", \"apple\", \"banana\"]\n",
    "\n",
    "print_list(fruits)                            "
   ]
